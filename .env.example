APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Outgoing email. Local development logs mail instead of sending it (MAIL_MAILER=log).
# Production with Google Workspace (smtp.gmail.com): the account needs 2-Step Verification and an App Password
# (Google Account → Security → App passwords). MAIL_FROM_ADDRESS must be that account or one of its "Send mail as" aliases.
#   MAIL_MAILER=smtp
#   MAIL_SCHEME=null
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=info@wonderhimalaya.com
#   MAIL_PASSWORD="xxxx xxxx xxxx xxxx"
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@wonderhimalaya.com"
MAIL_FROM_NAME="Wonder Himalaya"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- API / security ---
API_VERSION=v1
CSP_ENABLED=true
CSP_REPORT_ONLY=true
CSP_REPORT_URI=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# --- Payments ---
PAYMENT_LINK_TTL_DAYS=14
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
NEPAL_BANK_LABEL="Credit / debit card"
NEPAL_BANK_ACCESS_KEY=
NEPAL_BANK_PROFILE_ID=
NEPAL_BANK_SECRET_KEY=
NEPAL_BANK_ENDPOINT=https://testsecureacceptance.cybersource.com/pay
NEPAL_BANK_CURRENCY=USD

# --- Backups ---
BACKUP_NAME=wonderhimalaya
BACKUP_DISKS=local
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=
